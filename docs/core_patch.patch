@@ -0,0 +1,86 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+
+namespace mod_quiz\hook;
+
+use core\hook\described_hook;
+
+/**
+ * Allows plugins to extend the quiz question add menu.
+ *
+ * @package    mod_quiz
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\core\attribute\label('Allows plugins to extend the quiz question add menu')]
+#[\core\attribute\tags('quiz')]
+final class edit_menu_actions implements described_hook {
+    /** @var array<string, \action_menu_link> */
+    private array $actions;
+
+    public function __construct(
+        /** @var \mod_quiz\structure */
+        private readonly \mod_quiz\structure $structure,
+        /** @var int */
+        private readonly int $page,
+        /** @var \moodle_url */
+        private readonly \moodle_url $pageurl,
+        /** @var array */
+        private readonly array $pagevars,
+        array $actions,
+    ) {
+        $this->actions = $actions;
+    }
+
+    public static function get_hook_description(): string {
+        return 'Allows plugins to extend the quiz question add menu.';
+    }
+
+    public static function get_hook_tags(): array {
+        return ['quiz'];
+    }
+
+    public function get_structure(): \mod_quiz\structure {
+        return $this->structure;
+    }
+
+    public function get_page(): int {
+        return $this->page;
+    }
+
+    public function get_page_url(): \moodle_url {
+        return $this->pageurl;
+    }
+
+    public function get_pagevars(): array {
+        return $this->pagevars;
+    }
+
+    /**
+     * Add or replace an action. Passing null removes an existing action.
+     *
+     * @param string $identifier plugin-prefixed unique identifier
+     * @param \action_menu_link|null $action action to add
+     */
+    public function add_action(string $identifier, ?\action_menu_link $action): void {
+        if ($action === null) {
+            unset($this->actions[$identifier]);
+            return;
+        }
+        $lastkey = array_key_last($this->actions);
+        $lastaction = $lastkey === null ? null : $this->actions[$lastkey];
+        if ($lastkey !== null) {
+            unset($this->actions[$lastkey]);
+        }
+        $this->actions[$identifier] = $action;
+        if ($lastkey !== null) {
+            $this->actions[$lastkey] = $lastaction;
+        }
+    }
+
+    /**
+     * @return array<string, \action_menu_link>
+     */
+    public function get_actions(): array {
+        return $this->actions;
+    }
+}
