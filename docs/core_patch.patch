+final class before_attempt_questions_created implements described_hook {
+    /** @var array<int, \stdClass> */
+    private array $questions;
+
+    public function __construct(
+        /** @var \mod_quiz\quiz_settings */
+        private readonly \mod_quiz\quiz_settings $quiz,
+        /** @var int */
+        private readonly int $userid,
+        array $questions,
+    ) {
+        $this->questions = $questions;
+    }
+
+    public static function get_hook_description(): string {
+        return 'Allows plugins to filter quiz questions before an attempt is created.';
+    }
+
+    public static function get_hook_tags(): array {
+        return ['quiz'];
+    }
+
+    public function get_quiz(): \mod_quiz\quiz_settings {
+        return $this->quiz;
+    }
+
+    public function get_userid(): int {
+        return $this->userid;
+    }
+
+    /**
+     * Remove a question by its question-bank id.
+     *
+     * @param int $questionid question-bank id
+     */
+    public function remove_question(int $questionid): void {
+        unset($this->questions[$questionid]);
+    }
+
+    /**
+     * @return array<int, \stdClass>
+     */
+    public function get_questions(): array {
+        return $this->questions;
+    }
+}
